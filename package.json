{
  "name": "teecas-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Teecas admin backend: orders, menu, inventory, analytics and branches, plus the API the ordering app uses.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --config web/vite.config.js\"",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mingo": "^7.2.5",
    "mongodb": "^7.7.0",
    "vite": "^8.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}

# Copy to .env for local runs. On Render, set these under Environment.

# MongoDB Atlas connection string. Leave unset to use a local file store (demo/dev only:
# Render wipes the disk on each deploy, so production needs MongoDB).
MONGODB_URI=
MONGODB_DB=teecas

# Long random string that signs staff sign-ins. Required in production.
JWT_SECRET=

PORT=4000
RESTAURANT_NAME=Teecas Amala Express Bukka
RESTAURANT_TIMEZONE=Africa/Lagos

# First start on an empty database loads demo branches, menu, stock, staff and sample orders.
# Set to false to start empty.
SEED_DEMO=true
SEED_OWNER_EMAIL=owner@teecas.online
SEED_OWNER_PASSWORD=teecas-demo
SEED_STAFF_PASSWORD=teecas-demo
# WhatsApp number every demo branch sends orders to (international format, no +).
SEED_WHATSAPP=2348088524502

# WhatsApp number app orders are sent to before a branch takes them (international format,
# no +). Leave empty to use the first open branch's number.
ORDERS_WHATSAPP=

# Show the demo accounts on the sign-in page. Defaults to true only on the local file store.
SHOW_DEMO_LOGINS=

# Optional: also message the branch directly from the server through Meta's WhatsApp Cloud API.
# Without these, the app opens WhatsApp with the order pre-written (same as teecas.online).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Needed for messages outside the 24-hour window: an approved template with 3 body
# parameters (order number, total, customer name).
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Email, for app customers who forget their password (they get a 6-digit code). Any SMTP
# provider works: Zoho Mail, Google Workspace (with an app password), Brevo, Resend, Mailgun,
# Amazon SES. Without SMTP_HOST no email is sent; the code is only printed in the server log.
SMTP_HOST=
SMTP_PORT=587
# true for port 465; leave empty to decide from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Who the email comes from, e.g. Teecas <no-reply@teecas.online>. Must be an address your
# provider lets you send from.
MAIL_FROM=
